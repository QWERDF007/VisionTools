{
  "schema_version": 5,
  "name_en": "visionrt.flow.receive",
  "name_zh": "跨流程接收",
  "version": "1.0.0",
  "implementation": {
    "kind": "host",
    "binding": "visionrt.receiver"
  },
  "ui": {
    "category": [
      "流程控制",
      "跨流程"
    ]
  },
  "ports": {
    "init": [
      {
        "name_en": "source_flow_id",
        "name_zh": "源流程ID",
        "type": "string"
      },
      {
        "name_en": "source_node_seq",
        "name_zh": "源节点序号",
        "type": "string"
      },
      {
        "name_en": "source_port_id",
        "name_zh": "源端口ID",
        "type": "string"
      },
      {
        "name_en": "timeout_ms",
        "name_zh": "超时时间(ms)",
        "type": "int",
        "constraints": {
          "min": 0
        }
      }
    ],
    "outputs": [
      {
        "name_en": "value",
        "name_zh": "接收数据",
        "type_from": {
          "flow": "init.source_flow_id",
          "node": "init.source_node_seq",
          "port": "init.source_port_id"
        }
      },
      {
        "name_en": "source_status_code",
        "name_zh": "源状态码",
        "type": "int"
      },
      {
        "name_en": "source_status_message",
        "name_zh": "源状态消息",
        "type": "string"
      }
    ]
  }
}
