{
  "schema_version": 4,
  "category": "采集",
  "subcategory": "图像采集",
  "tool_id": "visionrt.image.read",
  "display_name": "图像读取",
  "version": "1.0.0",
  "kind": "cpp",
  "init_params": [],
  "inputs": [
    {
      "id": "path",
      "name": "图像路径",
      "type": "String",
      "default": "",
      "editor": "path",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "recursive",
      "name": "递归选项",
      "type": "Bool",
      "default": false,
      "editor": "bool",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "traversal",
      "name": "遍历选项",
      "type": "String",
      "default": "循环",
      "options": [
        "循环",
        "不循环"
      ],
      "editor": "text",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "order",
      "name": "遍历顺序",
      "type": "String",
      "default": "顺序（下一张）",
      "options": [
        "顺序（下一张）",
        "逆序（上一张）"
      ],
      "editor": "text",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "count",
      "name": "图像数量",
      "type": "Int",
      "default": 1,
      "min": 1,
      "max": 64,
      "editor": "number",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "reload",
      "name": "重新读图",
      "type": "Bool",
      "default": false,
      "editor": "bool",
      "tab": "基本输入",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "paths",
      "name": "文件路径",
      "type": "Array",
      "rank": 1,
      "dtype": "string",
      "required": true
    },
    {
      "id": "current_index",
      "name": "当前索引",
      "type": "Int",
      "required": true
    },
    {
      "id": "total_count",
      "name": "目录总数量",
      "type": "Int",
      "required": true
    },
    {
      "id": "end_reached",
      "name": "已到末项",
      "type": "Bool",
      "required": true
    }
  ]
}
