{
  "schema_version": 3,
  "category": "采集",
  "subcategory": "图像采集",
  "tool_id": "visionrt.image.read",
  "display_name": "图像读取",
  "version": "1.0.0",
  "kind": "cpp",
  "init_params": [],
  "inputs": [
    {
      "id": "mode",
      "name": "读取模式",
      "type": "String",
      "default": "file",
      "editor": "text",
      "tab": "基本输入",
      "options": [
        "file",
        "directory",
        "list"
      ],
      "required": true
    },
    {
      "id": "path",
      "name": "文件或目录路径",
      "type": "String",
      "default": "",
      "editor": "path",
      "path_mode_from": "mode",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "paths_in",
      "name": "文件列表",
      "type": "Array",
      "dtype": "string",
      "rank": 1,
      "default": [],
      "editor": "array",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "read_mode",
      "name": "读取方式",
      "type": "String",
      "default": "all",
      "editor": "text",
      "tab": "基本输入",
      "options": [
        "all",
        "sequence"
      ],
      "required": true
    },
    {
      "id": "color",
      "name": "色彩模式",
      "type": "String",
      "default": "bgr",
      "editor": "text",
      "tab": "基本输入",
      "options": [
        "bgr",
        "gray",
        "unchanged"
      ],
      "required": true
    },
    {
      "id": "recursive",
      "name": "包含子目录",
      "type": "Bool",
      "default": false,
      "editor": "bool",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "extensions",
      "name": "后缀筛选",
      "type": "Array",
      "dtype": "string",
      "rank": 1,
      "default": [
        "png",
        "jpg",
        "jpeg",
        "bmp",
        "tif",
        "tiff"
      ],
      "editor": "array",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "end_policy",
      "name": "序列末尾行为",
      "type": "String",
      "default": "wrap",
      "editor": "text",
      "tab": "基本输入",
      "options": [
        "wrap",
        "hold",
        "error"
      ],
      "required": true
    },
    {
      "id": "limit",
      "name": "最大图像数量",
      "type": "Int",
      "default": 0,
      "min": 0,
      "editor": "number",
      "tab": "基本输入",
      "required": true
    },
    {
      "id": "max_batch_bytes",
      "name": "本次图像字节上限",
      "type": "Int",
      "default": 0,
      "min": 0,
      "editor": "number",
      "tab": "基本输入",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "display": {
        "color_order": "BGR"
      },
      "required": true
    },
    {
      "id": "paths",
      "name": "文件路径",
      "type": "Array",
      "rank": 1,
      "dtype": "string",
      "required": true
    },
    {
      "id": "current_index",
      "name": "当前索引",
      "type": "Int",
      "required": true
    },
    {
      "id": "total_count",
      "name": "目录总数量",
      "type": "Int",
      "required": true
    },
    {
      "id": "end_reached",
      "name": "已到末项",
      "type": "Bool",
      "required": true
    }
  ]
}
