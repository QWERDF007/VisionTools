{
  "schema_version": 5,
  "name_en": "visiontools.measure.circle",
  "name_zh": "测量圆",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "测量",
      "尺寸测量"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "图像",
        "type": "image"
      },
      {
        "name_en": "rois",
        "name_zh": "测量区域",
        "type": "roi",
        "default": [],
        "ui": {
          "editor": "array"
        },
        "relations": {
          "image": "inputs.images",
          "alignment": "inputs.alignment"
        }
      },
      {
        "name_en": "alignment",
        "name_zh": "参考到当前变换",
        "type": "vec_vec_vec_float",
        "ui": {
          "editor": "array"
        }
      },
      {
        "name_en": "num_calipers",
        "name_zh": "卡尺数量",
        "type": "int",
        "default": 64,
        "constraints": {
          "min": 12,
          "max": 4096
        },
        "ui": {
          "editor": "number"
        }
      },
      {
        "name_en": "search_half_width",
        "name_zh": "径向半搜索宽度",
        "type": "float",
        "default": 8.0,
        "constraints": {
          "min": 0.5,
          "max": 4096.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "average_width",
        "name_zh": "切向平均宽度",
        "type": "float",
        "default": 3.0,
        "constraints": {
          "min": 1.0,
          "max": 1024.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "sigma",
        "name_zh": "平滑标准差",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 0.1,
          "max": 20.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "min_gradient",
        "name_zh": "最小梯度",
        "type": "float",
        "default": 8.0,
        "constraints": {
          "min": 0.0,
          "max": 255.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "polarity",
        "name_zh": "边缘极性",
        "type": "string",
        "default": "any",
        "constraints": {
          "options": [
            "any",
            "dark_to_light",
            "light_to_dark"
          ]
        },
        "ui": {
          "editor": "text"
        }
      },
      {
        "name_en": "min_points",
        "name_zh": "最少有效点",
        "type": "int",
        "default": 12,
        "constraints": {
          "min": 3,
          "max": 4096
        },
        "ui": {
          "editor": "number"
        }
      },
      {
        "name_en": "min_completeness",
        "name_zh": "最小完整度",
        "type": "float",
        "default": 0.6,
        "constraints": {
          "min": 0.0,
          "max": 1.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "min_coverage_deg",
        "name_zh": "最小覆盖角度",
        "type": "float",
        "default": 180.0,
        "constraints": {
          "min": 0.0,
          "max": 360.0
        },
        "ui": {
          "editor": "number",
          "decimals": 1
        }
      },
      {
        "name_en": "radius_min",
        "name_zh": "最小半径",
        "type": "float",
        "default": 0.5,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "radius_max",
        "name_zh": "最大半径",
        "type": "float",
        "default": 1000000.0,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "max_rms",
        "name_zh": "最大拟合误差",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "units_per_pixel",
        "name_zh": "每像素物理长度",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 1e-09
        },
        "ui": {
          "editor": "number",
          "decimals": 6
        }
      },
      {
        "name_en": "unit",
        "name_zh": "单位",
        "type": "string",
        "default": "px",
        "ui": {
          "editor": "text"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "显示图像",
        "type": "image",
        "display": {
          "color_order": "BGR"
        }
      },
      {
        "name_en": "valid",
        "name_zh": "逐ROI有效性",
        "type": "vec_vec_bool"
      },
      {
        "name_en": "reasons",
        "name_zh": "逐ROI说明",
        "type": "vec_vec_string"
      },
      {
        "name_en": "valid_count",
        "name_zh": "逐图有效圆数量",
        "type": "vec_int"
      },
      {
        "name_en": "source_roi_indices",
        "name_zh": "有效圆来源索引",
        "type": "vec_vec_int"
      },
      {
        "name_en": "circles",
        "name_zh": "测得圆",
        "type": "roi",
        "relations": {
          "image": "outputs.images"
        }
      },
      {
        "name_en": "centers",
        "name_zh": "圆心坐标",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "radius_px",
        "name_zh": "半径像素值",
        "type": "vec_vec_float"
      },
      {
        "name_en": "radius",
        "name_zh": "半径物理值",
        "type": "vec_vec_float"
      },
      {
        "name_en": "rms",
        "name_zh": "拟合误差像素值",
        "type": "vec_vec_float"
      },
      {
        "name_en": "completeness",
        "name_zh": "完整度",
        "type": "vec_vec_float"
      },
      {
        "name_en": "used_edges",
        "name_zh": "拟合边缘点",
        "type": "roi",
        "relations": {
          "image": "outputs.images"
        }
      },
      {
        "name_en": "unit",
        "name_zh": "单位",
        "type": "string"
      }
    ]
  },
  "interaction": {
    "helper": "visiontools.assist.circle",
    "inputs": {
      "images": "inputs.images",
      "seed_rois": "inputs.rois",
      "alignment": "inputs.alignment"
    },
    "proposals": {
      "proposal_rois": "inputs.rois",
      "suggested_search_half_width": "inputs.search_half_width",
      "suggested_polarity": "inputs.polarity"
    },
    "roi_kinds": [
      "circle"
    ]
  }
}
