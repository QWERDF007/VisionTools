{
  "schema_version": 5,
  "name_en": "visiontools.measure.row_spacing",
  "name_zh": "测量行间距",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "测量",
      "尺寸测量"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "图像",
        "type": "image"
      },
      {
        "name_en": "rois",
        "name_zh": "测量区域",
        "type": "roi",
        "default": [],
        "ui": {
          "editor": "array"
        },
        "relations": {
          "image": "inputs.images",
          "alignment": "inputs.alignment"
        }
      },
      {
        "name_en": "alignment",
        "name_zh": "参考到当前变换",
        "type": "vec_vec_vec_float",
        "ui": {
          "editor": "array"
        }
      },
      {
        "name_en": "sigma",
        "name_zh": "平滑标准差",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 0.1,
          "max": 20.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "min_gradient",
        "name_zh": "最小梯度",
        "type": "float",
        "default": 8.0,
        "constraints": {
          "min": 0.0,
          "max": 255.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "name_en": "object_polarity",
        "name_zh": "物体极性",
        "type": "string",
        "default": "bright",
        "constraints": {
          "options": [
            "bright",
            "dark"
          ]
        },
        "ui": {
          "editor": "text"
        }
      },
      {
        "name_en": "width_min",
        "name_zh": "合格宽度下限",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "width_max",
        "name_zh": "合格宽度上限",
        "type": "float",
        "default": 1000000.0,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "units_per_pixel",
        "name_zh": "每像素物理长度",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 1e-09
        },
        "ui": {
          "editor": "number",
          "decimals": 6
        }
      },
      {
        "name_en": "unit",
        "name_zh": "单位",
        "type": "string",
        "default": "px",
        "ui": {
          "editor": "text"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "显示图像",
        "type": "image",
        "display": {
          "color_order": "BGR"
        }
      },
      {
        "name_en": "valid_roi",
        "name_zh": "逐ROI有效性",
        "type": "vec_vec_bool"
      },
      {
        "name_en": "reasons",
        "name_zh": "逐ROI说明",
        "type": "vec_vec_string"
      },
      {
        "name_en": "pair_count",
        "name_zh": "完整物体数量",
        "type": "vec_vec_int"
      },
      {
        "name_en": "accepted_count",
        "name_zh": "宽度合格数量",
        "type": "vec_vec_int"
      },
      {
        "name_en": "unpaired_count",
        "name_zh": "未配对边缘数量",
        "type": "vec_vec_int"
      },
      {
        "name_en": "accepted",
        "name_zh": "逐物体宽度合格",
        "type": "vec_vec_vec_bool"
      },
      {
        "name_en": "width_px",
        "name_zh": "宽度像素值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "gap_px",
        "name_zh": "间隙像素值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "pitch_px",
        "name_zh": "节距像素值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "width",
        "name_zh": "宽度物理值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "gap",
        "name_zh": "间隙物理值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "pitch",
        "name_zh": "节距物理值",
        "type": "vec_vec_vec_float"
      },
      {
        "name_en": "pair_points",
        "name_zh": "物体边缘中点",
        "type": "vec_vec_vec_vec_float"
      },
      {
        "name_en": "overlay_segments",
        "name_zh": "边缘显示线段",
        "type": "roi",
        "relations": {
          "image": "outputs.images"
        }
      },
      {
        "name_en": "unit",
        "name_zh": "单位",
        "type": "string"
      }
    ]
  },
  "interaction": {
    "helper": "visiontools.assist.row_spacing",
    "inputs": {
      "images": "inputs.images",
      "seed_rois": "inputs.rois",
      "alignment": "inputs.alignment"
    },
    "proposals": {
      "proposal_rois": "inputs.rois",
      "suggested_polarity": "inputs.object_polarity",
      "suggested_width_min": "inputs.width_min",
      "suggested_width_max": "inputs.width_max"
    },
    "roi_kinds": [
      "rectangle"
    ]
  }
}
