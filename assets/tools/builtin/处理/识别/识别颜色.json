{
  "name_en": "RecognizeColor",
  "name_zh": "识别颜色",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [
    {
      "id": 1,
      "name_zh": "颜色模型路径",
      "type": "string",
      "ui": {
        "editor": "path"
      }
    }
  ],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      }
    },
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": {
        "type": "array",
        "dtype": "float64",
        "rank": 3
      },
      "ui": {
        "editor": "array"
      }
    },
    {
      "id": 3,
      "name_zh": "检测区域",
      "type": "roi",
      "default": [],
      "ui": {
        "editor": "array"
      },
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        },
        "alignment": {
          "stage": "inputs",
          "id": 2
        }
      }
    },
    {
      "id": 4,
      "name_zh": "最低分数",
      "type": "float",
      "default": 0.05,
      "constraints": {
        "min": 0.0,
        "max": 1.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 3
      }
    },
    {
      "id": 5,
      "name_zh": "最低分类像素比例",
      "type": "float",
      "default": 0.5,
      "constraints": {
        "min": 0.0,
        "max": 1.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 3
      }
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "显示图像",
      "type": "image",
      "relations": {
        "same_geometry_as": {
          "stage": "inputs",
          "id": 1
        }
      },
      "display": {
        "visible": true
      }
    },
    {
      "id": 3,
      "name_zh": "检测区域",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "outputs",
          "id": 2
        }
      }
    },
    {
      "id": 4,
      "name_zh": "识别颜色",
      "type": {
        "type": "array",
        "dtype": "string",
        "rank": 2
      }
    },
    {
      "id": 5,
      "name_zh": "颜色分数",
      "type": {
        "type": "array",
        "dtype": "float32",
        "rank": 2
      }
    },
    {
      "id": 6,
      "name_zh": "分类像素比例",
      "type": {
        "type": "array",
        "dtype": "float32",
        "rank": 2
      }
    },
    {
      "id": 7,
      "name_zh": "中心 X",
      "type": {
        "type": "array",
        "dtype": "float32",
        "rank": 2
      }
    },
    {
      "id": 8,
      "name_zh": "中心 Y",
      "type": {
        "type": "array",
        "dtype": "float32",
        "rank": 2
      }
    }
  ],
  "training": {
    "image": {
      "stage": "inputs",
      "id": 1
    },
    "records": {
      "fields": [
        {
          "id": 1,
          "name_zh": "颜色名称",
          "type": "string"
        },
        {
          "id": 2,
          "name_zh": "采样区",
          "type": "roi",
          "roi": true,
          "regions": {
            "min": 1
          }
        }
      ]
    },
    "call": {
      "tool": "TrainColorModel",
      "inputs": [
        {
          "port": 1,
          "context": "training_set"
        },
        {
          "port": 2,
          "field_id": 1
        },
        {
          "port": 3,
          "field_id": 2
        }
      ]
    },
    "artifacts": [
      {
        "id": "color-model",
        "source_port": 2,
        "format": "visiontools.color-model",
        "version": 1,
        "target": {
          "stage": "init",
          "id": 1
        }
      }
    ]
  },
  "schema_version": 2
}
