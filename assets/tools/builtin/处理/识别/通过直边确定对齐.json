{
  "name_en": "AlignStraightBorders",
  "name_zh": "通过直边确定对齐",
  "version": "2.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [
    {
      "id": 1,
      "name_zh": "直边模型路径",
      "type": "string",
      "ui": {
        "editor": "path"
      }
    }
  ],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      }
    },
    {
      "id": 2,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30.0,
      "constraints": {
        "min": 0.0,
        "max": 1024.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2
      }
    },
    {
      "id": 3,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "detection"
      }
    },
    {
      "id": 4,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          "any",
          "dark_to_light",
          "light_to_dark"
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "detection"
      }
    },
    {
      "id": 5,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0.0,
        "max": 1.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2
      }
    },
    {
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      },
      "name_zh": "搜索区域",
      "id": 6,
      "default": []
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": {
        "type": "array",
        "dtype": "float64",
        "rank": 3
      }
    },
    {
      "id": 3,
      "name_zh": "找到的边",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    }
  ],
  "training": {
    "image": {
      "stage": "inputs",
      "id": 1
    },
    "records": {
      "max": 1,
      "fields": []
    },
    "call": {
      "tool": "TrainStraightBorders",
      "inputs": [
        {
          "port": 1,
          "context": "training_set"
        },
        {
          "source": {
            "stage": "inputs",
            "id": 6
          },
          "port": 2
        },
        {
          "port": 3,
          "source": {
            "stage": "inputs",
            "id": 2
          }
        },
        {
          "port": 4,
          "source": {
            "stage": "inputs",
            "id": 3
          }
        },
        {
          "port": 5,
          "source": {
            "stage": "inputs",
            "id": 4
          }
        },
        {
          "port": 6,
          "source": {
            "stage": "inputs",
            "id": 5
          }
        }
      ]
    },
    "artifacts": [
      {
        "id": "edge-model",
        "source_port": 2,
        "format": "visiontools.straight-edge-model",
        "version": 2,
        "target": {
          "stage": "init",
          "id": 1
        }
      }
    ],
    "overlay_output": 3,
    "region_input": 6
  },
  "schema_version": 2
}