{
  "name_en": "AlignStraightBorders",
  "name_zh": "通过直边确定对齐",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      },
      "ui": {
        "tab": "basic_input",
        "group": "检测图像"
      }
    },
    {
      "id": 2,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30,
      "constraints": {
        "min": 0,
        "max": 1024
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2,
        "group": "边缘提取"
      }
    },
    {
      "id": 3,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "group": "边缘提取"
      }
    },
    {
      "id": 4,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          "any",
          "dark_to_light",
          "light_to_dark"
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "detection",
        "group": "边缘提取"
      }
    },
    {
      "id": 5,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0,
        "max": 1
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2,
        "group": "边缘提取"
      }
    },
    {
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      },
      "name_zh": "搜索区域",
      "id": 6,
      "default": [],
      "ui": {
        "tab": "basic_input",
        "group": "检测区域"
      }
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": {
        "type": "array",
        "dtype": "float64",
        "rank": 3
      },
      "produced_by": "execute"
    },
    {
      "id": 3,
      "name_zh": "找到的边",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
