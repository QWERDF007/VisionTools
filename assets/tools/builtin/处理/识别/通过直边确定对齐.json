{
  "name_en": "AlignStraightBorders",
  "name_zh": "通过直边确定对齐",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [
    {
      "id": 0,
      "name_zh": "训练数据路径",
      "type": "string",
      "ui": {
        "editor": "path"
      }
    }
  ],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      }
    },
    {
      "id": 2,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30.0,
      "constraints": {
        "min": 0.0,
        "max": 1024.0
      },
      "ui": {
        "editor": "number",
        "tab": "检测",
        "decimals": 2
      }
    },
    {
      "id": 3,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "检测"
      }
    },
    {
      "id": 4,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          "any",
          "dark_to_light",
          "light_to_dark"
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "检测"
      }
    },
    {
      "id": 5,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0.0,
        "max": 1.0
      },
      "ui": {
        "editor": "number",
        "tab": "检测",
        "decimals": 2
      }
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": "vec_vec_vec_float"
    },
    {
      "id": 3,
      "name_zh": "找到的边",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    },
    {
      "id": 4,
      "name_zh": "搜索区域",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    }
  ],
  "training": {
    "kind": "straight_edges",
    "asset_param": 0,
    "helper": "PickStraightEdge"
  }
}
