{
  "name_en": "AlignStraightBorders",
  "name_zh": "通过直边确定对齐",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [
    {
      "id": 1,
      "name_zh": "直边模型路径",
      "type": "string",
      "ui": {
        "editor": "path"
      }
    }
  ],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      }
    },
    {
      "id": 2,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30.0,
      "constraints": {
        "min": 0.0,
        "max": 1024.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2
      }
    },
    {
      "id": 3,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "detection"
      }
    },
    {
      "id": 4,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          "any",
          "dark_to_light",
          "light_to_dark"
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "detection"
      }
    },
    {
      "id": 5,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0.0,
        "max": 1.0
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2
      }
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": {
        "type": "array",
        "dtype": "float64",
        "rank": 3
      }
    },
    {
      "id": 3,
      "name_zh": "找到的边",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    },
    {
      "id": 4,
      "name_zh": "搜索区域",
      "type": "roi",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    }
  ],
  "training": {
    "image": {
      "stage": "inputs",
      "id": 1
    },
    "records": {
      "max": 1,
      "fields": [
        {
          "id": 1,
          "name_zh": "参考边",
          "type": "roi",
          "roi": true,
          "regions": {
            "min": 2,
            "max": 2
          }
        }
      ]
    },
    "call": {
      "tool": "TrainStraightBorders",
      "inputs": [
        {
          "port": 1,
          "context": "training_set"
        },
        {
          "port": 2,
          "field_id": 1
        },
        {
          "port": 3,
          "parameter": 2
        },
        {
          "port": 4,
          "parameter": 3
        },
        {
          "port": 5,
          "parameter": 4
        },
        {
          "port": 6,
          "parameter": 5
        }
      ]
    },
    "artifacts": [
      {
        "id": "edge-model",
        "source_port": 2,
        "format": "visiontools.straight-edge-model",
        "version": 1,
        "target": {
          "stage": "init",
          "id": 1
        }
      }
    ],
    "overlay_output": 3,
    "parameters": [
      {
        "id": 2,
        "name_zh": "边缘对比度",
        "type": "float",
        "default": 30.0,
        "constraints": {
          "min": 0.0,
          "max": 1024.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      },
      {
        "id": 3,
        "name_zh": "边缘宽度",
        "type": "int",
        "default": 3,
        "constraints": {
          "min": 1,
          "max": 63
        },
        "ui": {
          "editor": "number"
        }
      },
      {
        "id": 4,
        "name_zh": "跃迁方向",
        "type": "string",
        "default": "any",
        "constraints": {
          "options": [
            "any",
            "dark_to_light",
            "light_to_dark"
          ]
        },
        "ui": {
          "editor": "text"
        }
      },
      {
        "id": 5,
        "name_zh": "最低边完整度",
        "type": "float",
        "default": 0.4,
        "constraints": {
          "min": 0.0,
          "max": 1.0
        },
        "ui": {
          "editor": "number",
          "decimals": 2
        }
      }
    ]
  },
  "schema_version": 2
}
