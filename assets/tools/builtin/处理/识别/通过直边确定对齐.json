{
  "name_en": "AlignStraightBorders",
  "name_zh": "通过直边确定对齐",
  "version": "3.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "init_params": [],
  "inputs": [
    {
      "id": 1,
      "name_zh": "图像",
      "type": "image",
      "display": {
        "visible": true
      },
      "ui": {
        "tab": "basic_input",
        "group": "检测图像"
      }
    },
    {
      "id": 2,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30,
      "constraints": {
        "min": 0,
        "max": 1024
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2,
        "group": "边缘提取"
      }
    },
    {
      "id": 3,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "group": "边缘提取"
      }
    },
    {
      "id": 4,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          {
            "value": "any",
            "label": "任意"
          },
          {
            "value": "dark_to_light",
            "label": "暗到亮"
          },
          {
            "value": "light_to_dark",
            "label": "亮到暗"
          }
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "detection",
        "group": "边缘提取"
      }
    },
    {
      "id": 5,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0,
        "max": 1
      },
      "ui": {
        "editor": "number",
        "tab": "detection",
        "decimals": 2,
        "group": "边缘提取"
      }
    },
    {
      "type": "rectangle",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      },
      "name_zh": "搜索区域",
      "id": 6,
      "default": [],
      "ui": {
        "tab": "basic_input",
        "group": "检测区域"
      }
    }
  ],
  "outputs": [
    {
      "id": 2,
      "name_zh": "对齐数据",
      "type": {
        "type": "array",
        "dtype": "float64",
        "rank": 2
      },
      "produced_by": "execute"
    },
    {
      "id": 3,
      "name_zh": "找到的边",
      "type": "line",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    },
    {
      "id": 4,
      "name_zh": "模型路径",
      "type": "string"
    },
    {
      "id": 5,
      "name_zh": "搜索方向",
      "type": "direction",
      "relations": {
        "image": {
          "stage": "inputs",
          "id": 1
        }
      }
    }
  ],
  "training": {
    "datasets": [
      {
        "parameter": 7,
        "image": {
          "stage": "inputs",
          "id": 1
        },
        "fields": [
          {
            "id": 2,
            "name_zh": "训练搜索区域",
            "type": "rectangle",
            "default": [],
            "ui": {
              "editor": "roi",
              "group": "训练数据",
              "tab": "training"
            },
            "constraints": {
              "regions": {
                "min": 2,
                "max": 2
              }
            }
          }
        ],
        "max_records": 1
      }
    ],
    "artifacts": [
      {
        "id": "edge-model",
        "source_port": 4,
        "format": "visiontools.straight-edge-model",
        "version": 2,
        "target": {
          "stage": "train_params",
          "id": 1
        }
      }
    ]
  },
  "schema_version": 4,
  "train_params": [
    {
      "id": 1,
      "name_zh": "直边模型路径",
      "type": "string",
      "ui": {
        "editor": "path",
        "group": "模型",
        "tab": "training"
      }
    },
    {
      "id": 3,
      "name_zh": "边缘对比度",
      "type": "float",
      "default": 30,
      "constraints": {
        "min": 0,
        "max": 1024
      },
      "ui": {
        "editor": "number",
        "tab": "training",
        "decimals": 2,
        "group": "训练参数"
      }
    },
    {
      "id": 4,
      "name_zh": "边缘宽度",
      "type": "int",
      "default": 3,
      "constraints": {
        "min": 1,
        "max": 63
      },
      "ui": {
        "editor": "number",
        "tab": "training",
        "group": "训练参数"
      }
    },
    {
      "id": 5,
      "name_zh": "跃迁方向",
      "type": "string",
      "default": "any",
      "constraints": {
        "options": [
          {
            "value": "any",
            "label": "任意"
          },
          {
            "value": "dark_to_light",
            "label": "暗到亮"
          },
          {
            "value": "light_to_dark",
            "label": "亮到暗"
          }
        ]
      },
      "ui": {
        "editor": "text",
        "tab": "training",
        "group": "训练参数"
      }
    },
    {
      "id": 6,
      "name_zh": "最低边完整度",
      "type": "float",
      "default": 0.4,
      "constraints": {
        "min": 0,
        "max": 1
      },
      "ui": {
        "editor": "number",
        "tab": "training",
        "decimals": 2,
        "group": "训练参数"
      }
    },
    {
      "id": 7,
      "name_zh": "训练样本",
      "type": "training_set",
      "ui": {
        "tab": "training",
        "group": "训练数据"
      }
    }
  ]
}
