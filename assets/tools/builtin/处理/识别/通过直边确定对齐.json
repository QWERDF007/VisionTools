  "training": {
    "image": {
      "stage": "inputs",
      "id": 1
    },
    "max_records": 1,
    "overlay_output": 3,
    "artifacts": [
      {
        "id": "edge-model",
        "source_port": 4,
        "format": "visiontools.straight-edge-model",
        "version": 2,
        "target": {
          "stage": "train_params",
          "id": 1
        }
      }
    ]
