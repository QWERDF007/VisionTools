{
  "schema_version": 5,
  "name_en": "visionrt.detection.filter",
  "name_zh": "缺陷过滤",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "处理",
      "检测"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "图像",
        "type": "image"
      },
      {
        "name_en": "rois",
        "name_zh": "候选ROI",
        "type": "roi",
        "relations": {
          "image": "inputs.images"
        }
      },
      {
        "name_en": "scores",
        "name_zh": "置信度得分",
        "type": "vec_vec_float32"
      },
      {
        "name_en": "classes",
        "name_zh": "类别ID",
        "type": "vec_vec_int"
      },
      {
        "name_en": "class_names",
        "name_zh": "类别名称",
        "type": "vec_vec_string"
      },
      {
        "name_en": "min_score",
        "name_zh": "最低置信度",
        "type": "float",
        "default": 0.5,
        "constraints": {
          "min": 0,
          "max": 1
        },
        "ui": {
          "tab": "检测",
          "step": 0.05
        }
      },
      {
        "name_en": "min_area",
        "name_zh": "最小面积",
        "type": "float",
        "default": 1,
        "constraints": {
          "min": 0
        },
        "ui": {
          "tab": "检测",
          "step": 1
        }
      },
      {
        "name_en": "allowed_classes",
        "name_zh": "保留类别",
        "type": "vec_int",
        "ui": {
          "tab": "检测"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "输出图像",
        "type": "image",
        "relations": {
          "same_geometry_as": "inputs.images"
        },
        "display": {
          "color_order": "BGR"
        }
      },
      {
        "name_en": "rois",
        "name_zh": "过滤后ROI",
        "type": "roi",
        "relations": {
          "image": "outputs.images"
        }
      },
      {
        "name_en": "scores",
        "name_zh": "过滤后得分",
        "type": "vec_vec_float32"
      },
      {
        "name_en": "classes",
        "name_zh": "过滤后类别",
        "type": "vec_vec_int"
      },
      {
        "name_en": "class_names",
        "name_zh": "过滤后类别名",
        "type": "vec_vec_string"
      },
      {
        "name_en": "counts",
        "name_zh": "目标数量",
        "type": "vec_int"
      }
    ]
  }
}
