{
  "schema_version": 5,
  "name_en": "visiontools.image.rotate",
  "name_zh": "旋转图像",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "预处理",
      "图像处理"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "输入图像",
        "type": "image"
      },
      {
        "name_en": "angle_deg",
        "name_zh": "顺时针角度",
        "type": "float",
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "center",
        "name_zh": "旋转中心",
        "type": "vec_float",
        "ui": {
          "editor": "array"
        }
      },
      {
        "name_en": "canvas",
        "name_zh": "画布模式",
        "type": "string",
        "default": "keep",
        "constraints": {
          "options": [
            "keep",
            "expand"
          ]
        },
        "ui": {
          "editor": "text"
        }
      },
      {
        "name_en": "interpolation",
        "name_zh": "插值方式",
        "type": "string",
        "default": "linear",
        "constraints": {
          "options": [
            "nearest",
            "linear",
            "cubic"
          ]
        },
        "ui": {
          "editor": "text"
        }
      },
      {
        "name_en": "border_value",
        "name_zh": "边界填充值",
        "type": "vec_float",
        "default": [
          0.0
        ],
        "ui": {
          "editor": "array"
        }
      },
      {
        "name_en": "alignment",
        "name_zh": "参考到当前变换",
        "type": "vec_vec_vec_float",
        "ui": {
          "editor": "array"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "旋转图像",
        "type": "image"
      },
      {
        "name_en": "alignment",
        "name_zh": "参考到输出变换",
        "type": "vec_vec_vec_float"
      }
    ]
  }
}
