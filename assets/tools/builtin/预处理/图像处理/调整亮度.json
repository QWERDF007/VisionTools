{
  "schema_version": 5,
  "name_en": "visiontools.image.brightness",
  "name_zh": "调整亮度",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "预处理",
      "图像处理"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "输入图像",
        "type": "image"
      },
      {
        "name_en": "gain",
        "name_zh": "增益",
        "type": "float",
        "default": 1.0,
        "constraints": {
          "min": 0.0
        },
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "offset",
        "name_zh": "偏移",
        "type": "float",
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      },
      {
        "name_en": "rois",
        "name_zh": "测量区域",
        "type": "roi",
        "default": [],
        "ui": {
          "editor": "array"
        },
        "relations": {
          "image": "inputs.images",
          "alignment": "inputs.alignment"
        }
      },
      {
        "name_en": "mask",
        "name_zh": "输入掩码",
        "type": "image"
      },
      {
        "name_en": "alignment",
        "name_zh": "参考到当前变换",
        "type": "vec_vec_vec_float",
        "ui": {
          "editor": "array"
        }
      },
      {
        "name_en": "emit_mask",
        "name_zh": "输出应用区域",
        "type": "bool",
        "ui": {
          "editor": "bool"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "输出图像",
        "type": "image",
        "relations": {
          "same_geometry_as": "inputs.images"
        }
      },
      {
        "name_en": "applied_mask",
        "name_zh": "应用区域",
        "type": "image",
        "display": {
          "color_order": "Gray"
        }
      }
    ]
  }
}
