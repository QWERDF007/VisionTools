{
  "schema_version": 3,
  "category": "预处理",
  "subcategory": "图像处理",
  "tool_id": "visiontools.preprocess.adaptive_binary",
  "display_name": "自适应二值化",
  "version": "1.0.0",
  "kind": "cpp",
  "init_params": [],
  "inputs": [
    {
      "id": "images",
      "name": "输入图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "block_size",
      "name": "邻域大小",
      "type": "Int",
      "editor": "number",
      "default": 3,
      "min": 3,
      "max": 999,
      "step": 2,
      "required": true
    },
    {
      "id": "constant_offset",
      "name": "偏移常量",
      "type": "Float",
      "editor": "number",
      "default": 5,
      "decimals": 3,
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "二值图像",
      "type": "Image",
      "display": {
        "color_order": "Gray",
        "same_geometry_as_input": "images"
      },
      "required": true
    }
  ]
}
