{
  "schema_version": 5,
  "name_en": "visiontools.preprocess.adaptive_binary",
  "name_zh": "自适应二值化",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "预处理",
      "图像处理"
    ]
  },
  "ports": {
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "输入图像",
        "type": "image"
      },
      {
        "name_en": "block_size",
        "name_zh": "邻域大小",
        "type": "int",
        "default": 3,
        "constraints": {
          "min": 3,
          "max": 999
        },
        "ui": {
          "editor": "number",
          "step": 2
        }
      },
      {
        "name_en": "constant_offset",
        "name_zh": "偏移常量",
        "type": "float",
        "default": 5,
        "ui": {
          "editor": "number",
          "decimals": 3
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "二值图像",
        "type": "image",
        "relations": {
          "same_geometry_as": "inputs.images"
        },
        "display": {
          "color_order": "Gray"
        }
      }
    ]
  }
}
