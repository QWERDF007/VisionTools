{
  "schema_version": 3,
  "category": "预处理",
  "subcategory": "ROI",
  "tool_id": "visionrt.roi.projection",
  "display_name": "投影ROI",
  "version": "1.0.0",
  "kind": "cpp",
  "init_params": [],
  "inputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "axis",
      "name": "投影轴",
      "type": "String",
      "default": "x",
      "tab": "预处理",
      "options": [
        "x",
        "y"
      ],
      "required": true
    },
    {
      "id": "polarity",
      "name": "极性",
      "type": "String",
      "default": "bright",
      "tab": "预处理",
      "options": [
        "bright",
        "dark"
      ],
      "required": true
    },
    {
      "id": "threshold",
      "name": "二值化阈值",
      "type": "Int",
      "default": 128,
      "min": 0,
      "max": 255,
      "step": 1,
      "editor": "number",
      "tab": "预处理",
      "required": true
    },
    {
      "id": "min_pixels",
      "name": "最小像素数",
      "type": "Int",
      "default": 1,
      "min": 1,
      "editor": "number",
      "tab": "预处理",
      "required": true
    },
    {
      "id": "min_extent",
      "name": "最小跨度",
      "type": "Int",
      "default": 1,
      "min": 1,
      "editor": "number",
      "tab": "预处理",
      "required": true
    },
    {
      "id": "merge_gap",
      "name": "合并间隙",
      "type": "Int",
      "default": 0,
      "min": 0,
      "editor": "number",
      "tab": "预处理",
      "required": true
    },
    {
      "id": "padding",
      "name": "外扩边距",
      "type": "Int",
      "default": 0,
      "min": 0,
      "editor": "number",
      "tab": "预处理",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "输出图像",
      "type": "Image",
      "display": {
        "same_geometry_as_input": "images",
        "color_order": "BGR"
      },
      "required": true
    },
    {
      "id": "rois",
      "name": "ROI批次",
      "type": "ROI",
      "image_port": "images",
      "required": true
    }
  ]
}
