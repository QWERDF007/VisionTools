{
  "schema_version": 3,
  "category": "深度学习",
  "subcategory": "目标检测",
  "tool_id": "visionrt.dl.yolo",
  "display_name": "YOLO目标检测",
  "version": "1.0.0",
  "kind": "cpp",
  "init_params": [
    {
      "id": "model_name",
      "name": "模型名称",
      "type": "String",
      "default": "yolov8n",
      "options": [
        "yolov8n"
      ],
      "required": true
    },
    {
      "id": "load_mode",
      "name": "加载模式",
      "type": "String",
      "default": "engine",
      "options": [
        "engine",
        "build_wts"
      ],
      "required": true
    },
    {
      "id": "model_path",
      "name": "模型路径",
      "type": "String",
      "default": "",
      "editor": "file",
      "required": true
    },
    {
      "id": "engine_output_path",
      "name": "引擎输出路径",
      "type": "String",
      "default": "",
      "editor": "file",
      "required": true
    },
    {
      "id": "labels_path",
      "name": "标签路径",
      "type": "String",
      "default": "",
      "editor": "file",
      "required": true
    },
    {
      "id": "precision",
      "name": "推理精度",
      "type": "String",
      "default": "fp16",
      "required": true
    },
    {
      "id": "gpu_index",
      "name": "GPU编号",
      "type": "Int",
      "default": 0,
      "min": 0,
      "required": true
    },
    {
      "id": "input_width",
      "name": "输入宽度",
      "type": "Int",
      "default": 640,
      "min": 32,
      "required": true
    },
    {
      "id": "input_height",
      "name": "输入高度",
      "type": "Int",
      "default": 640,
      "min": 32,
      "required": true
    },
    {
      "id": "num_classes",
      "name": "类别数量",
      "type": "Int",
      "default": 80,
      "min": 1,
      "required": true
    }
  ],
  "inputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "conf_threshold",
      "name": "置信度阈值",
      "type": "Float",
      "default": 0.25,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "tab": "检测",
      "required": true
    },
    {
      "id": "nms_threshold",
      "name": "NMS阈值",
      "type": "Float",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "tab": "检测",
      "required": true
    },
    {
      "id": "max_detections",
      "name": "最大检测数",
      "type": "Int",
      "default": 300,
      "min": 1,
      "tab": "检测",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "输出图像",
      "type": "Image",
      "display": {
        "same_geometry_as_input": "images",
        "color_order": "BGR"
      },
      "required": true
    },
    {
      "id": "rois",
      "name": "目标ROI",
      "type": "ROI",
      "image_port": "images",
      "required": true
    },
    {
      "id": "scores",
      "name": "目标得分",
      "type": "Array",
      "dtype": "float32",
      "rank": 2,
      "required": true
    },
    {
      "id": "classes",
      "name": "目标类别",
      "type": "Array",
      "dtype": "int64",
      "rank": 2,
      "required": true
    },
    {
      "id": "class_names",
      "name": "目标类别名",
      "type": "Array",
      "rank": 2,
      "required": true,
      "dtype": "string"
    }
  ]
}
