{
  "schema_version": 5,
  "name_en": "visionrt.dl.yolo",
  "name_zh": "YOLO目标检测",
  "version": "1.0.0",
  "implementation": {
    "kind": "cpp"
  },
  "ui": {
    "category": [
      "深度学习",
      "目标检测"
    ]
  },
  "ports": {
    "init": [
      {
        "name_en": "model_name",
        "name_zh": "模型名称",
        "type": "string",
        "default": "yolov8n",
        "constraints": {
          "options": [
            "yolov8n"
          ]
        }
      },
      {
        "name_en": "load_mode",
        "name_zh": "加载模式",
        "type": "string",
        "default": "engine",
        "constraints": {
          "options": [
            "engine",
            "build_wts"
          ]
        }
      },
      {
        "name_en": "model_path",
        "name_zh": "模型路径",
        "type": "string",
        "ui": {
          "editor": "file"
        }
      },
      {
        "name_en": "engine_output_path",
        "name_zh": "引擎输出路径",
        "type": "string",
        "ui": {
          "editor": "file"
        }
      },
      {
        "name_en": "labels_path",
        "name_zh": "标签路径",
        "type": "string",
        "ui": {
          "editor": "file"
        }
      },
      {
        "name_en": "precision",
        "name_zh": "推理精度",
        "type": "string",
        "default": "fp16"
      },
      {
        "name_en": "gpu_index",
        "name_zh": "GPU编号",
        "type": "int",
        "constraints": {
          "min": 0
        }
      },
      {
        "name_en": "input_width",
        "name_zh": "输入宽度",
        "type": "int",
        "default": 640,
        "constraints": {
          "min": 32
        }
      },
      {
        "name_en": "input_height",
        "name_zh": "输入高度",
        "type": "int",
        "default": 640,
        "constraints": {
          "min": 32
        }
      },
      {
        "name_en": "num_classes",
        "name_zh": "类别数量",
        "type": "int",
        "default": 80,
        "constraints": {
          "min": 1
        }
      }
    ],
    "inputs": [
      {
        "name_en": "images",
        "name_zh": "图像",
        "type": "image"
      },
      {
        "name_en": "conf_threshold",
        "name_zh": "置信度阈值",
        "type": "float",
        "default": 0.25,
        "constraints": {
          "min": 0,
          "max": 1
        },
        "ui": {
          "tab": "检测",
          "step": 0.05
        }
      },
      {
        "name_en": "nms_threshold",
        "name_zh": "NMS阈值",
        "type": "float",
        "default": 0.45,
        "constraints": {
          "min": 0,
          "max": 1
        },
        "ui": {
          "tab": "检测",
          "step": 0.05
        }
      },
      {
        "name_en": "max_detections",
        "name_zh": "最大检测数",
        "type": "int",
        "default": 300,
        "constraints": {
          "min": 1
        },
        "ui": {
          "tab": "检测"
        }
      }
    ],
    "outputs": [
      {
        "name_en": "images",
        "name_zh": "输出图像",
        "type": "image",
        "relations": {
          "same_geometry_as": "inputs.images"
        },
        "display": {
          "color_order": "BGR"
        }
      },
      {
        "name_en": "rois",
        "name_zh": "目标ROI",
        "type": "roi",
        "relations": {
          "image": "outputs.images"
        }
      },
      {
        "name_en": "scores",
        "name_zh": "目标得分",
        "type": "vec_vec_float32"
      },
      {
        "name_en": "classes",
        "name_zh": "目标类别",
        "type": "vec_vec_int"
      },
      {
        "name_en": "class_names",
        "name_zh": "目标类别名",
        "type": "vec_vec_string"
      }
    ]
  }
}
